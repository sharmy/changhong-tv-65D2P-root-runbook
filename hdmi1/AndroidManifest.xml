<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.sharmy.chsource"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22" />

    <!-- TVServiceHandler 切源时会写 Settings.System，缺这个权限会被抛 SecurityException -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 回到系统时要杀掉 TV 播放器进程以释放底层视频资源 -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 连本机 127.0.0.1:5555 的 root adbd（自愈用），socket 需要这个权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="信号源"
        android:icon="@drawable/ic_menu"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <activity
            android:name=".SwitchActivity"
            android:label="信号源"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 主图标：HDMI1（机顶盒） -->
        <activity-alias
            android:name=".Hdmi1"
            android:targetActivity=".SwitchActivity"
            android:label="机顶盒 HDMI1"
            android:icon="@drawable/ic_hdmi1"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="source" android:value="E_INPUT_SOURCE_HDMI" />
        </activity-alias>

        <activity-alias
            android:name=".Hdmi2"
            android:targetActivity=".SwitchActivity"
            android:label="HDMI2"
            android:icon="@drawable/ic_hdmi2"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="source" android:value="E_INPUT_SOURCE_HDMI2" />
        </activity-alias>

        <activity-alias
            android:name=".Dtv"
            android:targetActivity=".SwitchActivity"
            android:label="数字电视 DTV"
            android:icon="@drawable/ic_dtv"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="source" android:value="E_INPUT_SOURCE_DTV" />
        </activity-alias>

        <activity-alias
            android:name=".Av"
            android:targetActivity=".SwitchActivity"
            android:label="AV 音视频"
            android:icon="@drawable/ic_av"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="source" android:value="E_INPUT_SOURCE_CVBS" />
        </activity-alias>

        <!-- 从 HDMI / DTV 回到安卓系统桌面（等价遥控器「主页」键） -->
        <activity-alias
            android:name=".Home"
            android:targetActivity=".SwitchActivity"
            android:label="回到系统桌面"
            android:icon="@drawable/ic_home"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="source" android:value="__SYS__" />
        </activity-alias>

        <!-- 直接弹出系统原生「信号源」菜单 -->
        <activity-alias
            android:name=".Menu"
            android:targetActivity=".SwitchActivity"
            android:label="信号源菜单"
            android:icon="@drawable/ic_menu"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="source" android:value="__MENU__" />
        </activity-alias>

        <!-- 开机自愈：重新 bind mount keylayout（修遥控器主页键） -->
        <service
            android:name=".SelfHealService"
            android:exported="false" />

        <!--
          常驻守护（前台服务）。这台电视禁止第三方 app 自启动：进程一死，
          JobScheduler 和 AlarmManager 都拉不回来（实测闹钟有 wakeup 但 receiver
          不被调用）。所以只能靠前台服务把进程钉住 —— 否则自愈重启框架时会把自己
          杀掉，之后永久失效。
        -->
        <service
            android:name=".KeepAliveService"
            android:exported="false" />

        <!--
          JobScheduler 执行体：长虹会拦第三方 BOOT_COMPLETED，靠系统调度器兜底。
          ⚠️ exported 必须为 true —— JobScheduler 以 system(uid 1000) 身份来绑定，
             写成 false 会导致任务一直 READY 却永远执行不了（不报错，极难排查）。
          ⚠️ 但它在这台电视上有个硬伤：app 进程退出后不会再被拉起（Job 挂在那儿
             overdue 也不动）。所以真正扛事的是下面的 AlarmReceiver。
        -->
        <service
            android:name=".HealJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <!--
          AlarmManager 闹钟：每 3 分钟唤醒一次。它是唯一能把"已死的 app 进程"
          重新拉起来的路（系统闹钟 → PendingIntent → 启动进程）。
          显式 PendingIntent，exported=false 即可。
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          触发自愈的广播：实测 BOOT_COMPLETED 被长虹拦掉（进程都拉不起来），
          所以把开机前后必定发生的广播全挂上，哪个能用算哪个；
          真正的兜底是 HealJobService 的周期任务。
        -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <!-- 外置存储挂载发生在 boot 早期，是很好的开机触发器 -->
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>


    </application>
</manifest>
